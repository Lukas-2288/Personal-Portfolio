---
// Generic drawings used as project thumbnails. Drawn from scratch; none of
// them show a real site, layout or product. Colors follow the theme.
import type { DIAGRAMS } from '../content.config';

interface Props {
  name: (typeof DIAGRAMS)[number];
}
const { name } = Astro.props;

const stationsX = Array.from({ length: 9 }, (_, i) => 76 + i * 26);
const tiles = Array.from({ length: 8 }, (_, i) => ({ x: 92 + (i % 4) * 46, y: 82 + Math.floor(i / 4) * 52 }));
---

<svg class="diagram" viewBox="0 0 360 200" aria-hidden="true" focusable="false">
  {name === 'fleet-loop' && (
    <g>
      <rect class="dg-track" x="44" y="58" width="272" height="84" rx="24" stroke-width="12" />
      <rect class="dg-path" x="44" y="58" width="272" height="84" rx="24" />
      <line class="dg-path" x1="180" y1="58" x2="180" y2="142" />
      {stationsX.map((x) => (
        <>
          <rect class="dg-muted" x={x - 5} y="36" width="10" height="8" rx="1.5" opacity="0.7" />
          <rect class="dg-muted" x={x - 5} y="156" width="10" height="8" rx="1.5" opacity="0.7" />
        </>
      ))}
      <rect class="dg-accent-line" x="326" y="89" width="18" height="22" rx="3" />
      <path class="dg-accent-line" d="M336 93 l-4 7 h6 l-4 7" />
      <rect class="dg-accent" x="92" y="136" width="20" height="12" rx="3" />
      <rect class="dg-accent" x="226" y="52" width="20" height="12" rx="3" opacity="0.6" />
      <rect class="dg-accent" x="174" y="92" width="12" height="18" rx="3" opacity="0.8" />
      <text class="dg-label" x="44" y="190">GENERIC DIAGRAM · NOT A REAL LAYOUT</text>
    </g>
  )}
  {name === 'phone-screens' && (
    <g>
      <rect class="dg-frame" x="112" y="22" width="64" height="136" rx="11" />
      <rect class="dg-accent" x="121" y="40" width="46" height="22" rx="3" opacity="0.75" />
      <rect class="dg-soft" x="121" y="68" width="46" height="10" rx="2" />
      <rect class="dg-soft" x="121" y="83" width="46" height="10" rx="2" />
      <rect class="dg-soft" x="121" y="98" width="32" height="10" rx="2" />
      <rect class="dg-soft" x="121" y="130" width="46" height="14" rx="3" />
      <rect class="dg-frame" x="190" y="36" width="64" height="136" rx="11" />
      <circle class="dg-accent-line" cx="222" cy="80" r="20" stroke-dasharray="3 4" />
      <circle class="dg-accent" cx="222" cy="80" r="3.5" />
      <rect class="dg-soft" x="199" y="116" width="46" height="10" rx="2" />
      <rect class="dg-soft" x="199" y="131" width="30" height="10" rx="2" />
    </g>
  )}
  {name === 'card-deck' && (
    <g>
      <rect class="dg-frame" x="128" y="40" width="88" height="124" rx="10" transform="rotate(-8 172 102)" opacity="0.5" />
      <rect class="dg-frame" x="148" y="36" width="88" height="124" rx="10" transform="rotate(5 192 98)" opacity="0.75" />
      <rect class="dg-box-accent" x="136" y="34" width="88" height="124" rx="10" />
      <rect class="dg-accent" x="146" y="44" width="68" height="62" rx="5" opacity="0.7" />
      <rect class="dg-soft" x="146" y="116" width="56" height="8" rx="2" />
      <rect class="dg-soft" x="146" y="130" width="36" height="8" rx="2" />
      <path class="dg-accent-line" d="M246 96 h34 m-7 -7 7 7 -7 7" />
      <path class="dg-arrow" d="M114 96 h-34 m7 -7 -7 7 7 7" />
    </g>
  )}
  {name === 'browser-grid' && (
    <g>
      <rect class="dg-frame" x="76" y="40" width="208" height="136" rx="8" />
      <line class="dg-track" x1="76" y1="62" x2="284" y2="62" stroke-width="1.5" />
      <circle class="dg-soft" cx="90" cy="51" r="3.5" />
      <circle class="dg-soft" cx="102" cy="51" r="3.5" />
      <circle class="dg-soft" cx="114" cy="51" r="3.5" />
      {tiles.map((t, i) => (
        <rect
          class={i === 1 ? 'dg-accent' : 'dg-soft'}
          x={t.x}
          y={t.y}
          width="34"
          height="44"
          rx="3"
          opacity={i === 1 ? 0.75 : undefined}
        />
      ))}
    </g>
  )}
</svg>
