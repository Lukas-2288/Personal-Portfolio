---
// Compact project entry for the home page's Projects section.
import type { CollectionEntry } from 'astro:content';
import Diagram from './Diagram.astro';
import Icon from './Icon.astro';
import Tags from './Tags.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
---

<a class="prow" href={url(`/projects/${project.id}/`)}>
  <div class="prow-thumb"><Diagram name={d.diagram} /></div>
  <div class="prow-body">
    <span class="label">{d.kind} · {d.dates}</span>
    <h3 class="prow-title">{d.title} <Icon name="arrow-right" size={16} /></h3>
    <p class="muted">{d.blurb}</p>
    <ul class="prow-metrics" aria-label="Results">
      {d.metrics.map((m) => (
        <li><strong>{m.value}</strong> {m.label}</li>
      ))}
    </ul>
    <Tags items={d.tags} limit={4} />
  </div>
</a>

<style>
  .prow {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 20px;
    padding: 16px;
    margin-inline: -16px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }
  .prow:hover {
    background: var(--surface);
    border-color: var(--line);
  }
  .prow:hover .prow-title {
    color: var(--accent);
  }
  .prow-thumb {
    align-self: start;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .prow-body {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .prow-title {
    font-size: var(--step-1);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .prow-body p {
    font-size: 0.9688rem;
  }
  .prow-metrics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    font-family: var(--font-mono);
    font-size: var(--label);
    color: var(--muted);
  }
  .prow-metrics strong {
    color: var(--text);
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .prow {
      grid-template-columns: 1fr;
      margin-inline: 0;
      padding: 0;
    }
    .prow:hover {
      background: none;
      border-color: transparent;
    }
    .prow-thumb {
      max-width: 320px;
    }
  }
</style>
