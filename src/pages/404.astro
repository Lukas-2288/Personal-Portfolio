---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" description="This page doesn't exist.">
  <main id="main" class="container narrow page">
    <p class="label">Error 404</p>
    <h1>This page doesn't exist.</h1>
    <p class="muted">The link may be old or mistyped.</p>
    <div class="btn-row">
      <a class="btn solid" href={url('/')}>Go to the home page</a>
      <a class="btn" href={url('/projects/')}>See projects</a>
    </div>
  </main>
</Base>

<style>
  .page {
    padding-block: 96px 0;
    display: grid;
    gap: 14px;
  }
  h1 {
    font-size: var(--step-4);
  }
  .btn-row {
    margin-top: 12px;
  }
</style>
